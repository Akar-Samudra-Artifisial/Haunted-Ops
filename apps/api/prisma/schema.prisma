// Haunted Ops data model. Migrations live in prisma/migrations and are committed.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum SignalKind {
  error_rate
  p95_ms
  up
}

enum HuntStatus {
  queued
  running
  succeeded
  failed
  cancelled
}
/// What asked for a Hunt: an opened Incident, or an operator.
enum HuntTrigger {
  auto
  operator
}
/// Why a Hunt ended. `diagnosed` is the only reason of a succeeded Hunt (CHECK "hunt_success_is_diagnosed").
enum HuntEndReason {
  diagnosed
  invalid_diagnosis
  no_diagnosis
  foreign_tool
  credit_cap
  daily_cap
  tool_limit
  timeout
  mcp_startup
  cli_error
  stream_error
  busy
  cooldown
  disabled
  incident_closed
  shutdown
  api_restart
  downstream
  diagnosed_upstream
  daily_limit
}

enum EvidenceKind {
  metric
  error
  log
  deploy
  commit
}

enum ProposalStatus {
  draft
  open
  approved
  merged
  rejected
}

/// Which signal sets the haunt level of a Service.
enum HauntReasonKind {
  error_rate
  p95
  down
}

/// `reasonKind` and `reasonValue` are both set or both null: CHECK "service_reason_both_or_none",
/// added by hand in the add_service_reason migration.
model Service {
  id          String           @id @default(cuid())
  name        String           @unique
  roomX       Int
  roomY       Int
  hauntLevel  Int              @default(0)
  reasonKind  HauntReasonKind?
  reasonValue Float?
  updatedAt   DateTime         @updatedAt
  signals     Signal[]
  incidents   Incident[]
  hunts       Hunt[]
}

model Signal {
  id        BigInt     @id @default(autoincrement())
  serviceId String
  kind      SignalKind
  value     Float
  at        DateTime
  service   Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, kind, at(sort: Desc)], map: "signal_latest_per_service")
  @@index([at], map: "signal_at")
}

/// At most one open Incident per Service: partial unique index
/// "incident_one_open_per_service" is added by hand in the first migration.
model Incident {
  id        String    @id @default(cuid())
  serviceId String
  openedAt  DateTime  @default(now())
  closedAt  DateTime?
  peakLevel Int       @default(0)
  service   Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  hunts     Hunt[]

  @@index([serviceId, openedAt(sort: Desc)])
}

/// One Exorcist investigation. CHECKs added by hand in the add_hunt_runner migration:
/// "hunt_success_is_diagnosed" (a succeeded Hunt has the reason `diagnosed` and a full diagnosis, and only
/// then), "hunt_culprit_sha_format" (40 lowercase hex) and "hunt_credits_not_negative".
model Hunt {
  id            String         @id @default(cuid())
  incidentId    String
  /// The Service of the Incident, kept here for "latest hunt per service".
  serviceId     String
  status        HuntStatus     @default(queued)
  trigger       HuntTrigger
  endReason     HuntEndReason?
  /// The name of the failed diagnosis check (reason `invalid_diagnosis`).
  invalidCheck  String?
  model         String
  credits       Float          @default(0)
  /// True when `credits` is the per-hunt cap, counted because the Hunt ended before Kiro reported its Credits.
  creditsEstimated Boolean     @default(false)
  toolCalls     Int            @default(0)
  /// The diagnosis, only for a succeeded Hunt. The SHA is the full 40 characters of the Deploy record.
  culpritDeploy String?
  culpritSha    String?
  /// The Service the culprit deploy belongs to: the hunted Service or one it depends on.
  culpritService String?
  summary       String?
  fixHint       String?
  /// What stopped the Hunt, in a few words (the refused tool title for `foreign_tool`). Max 200 characters.
  stopDetail    String?
  /// The Service of the Hunt that diagnosed this one's cause (reason `diagnosed_upstream`).
  diagnosedBy   String?
  /// The id of that Hunt.
  linkedHuntId  String?
  startedAt     DateTime?
  finishedAt    DateTime?
  durationMs    Int?
  createdAt     DateTime       @default(now())
  incident      Incident       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  service       Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  steps         HuntStep[]
  evidence      Evidence[]
  proposals     Proposal[]

  @@index([incidentId])
  @@index([serviceId, createdAt(sort: Desc)], map: "hunt_latest_per_service")
  @@index([startedAt], map: "hunt_started_at")
}

/// One tool call of a Hunt, in order. `summary` is built by the API from validated arguments.
model HuntStep {
  id      String   @id @default(cuid())
  huntId  String
  index   Int
  tool    String
  summary String
  at      DateTime
  hunt    Hunt     @relation(fields: [huntId], references: [id], onDelete: Cascade)

  @@unique([huntId, index])
}

model Evidence {
  id     String       @id @default(cuid())
  huntId String
  order  Int
  kind   EvidenceKind
  /// The Evidence handle issued by the MCP server (`deploy:d-7`), at most 80 characters.
  ref    String
  detail String
  /// True when the valid diagnosis cites it.
  cited  Boolean      @default(false)
  hunt   Hunt         @relation(fields: [huntId], references: [id], onDelete: Cascade)

  @@unique([huntId, order])
}

model Proposal {
  id         String         @id @default(cuid())
  huntId     String
  prUrl      String?
  status     ProposalStatus @default(draft)
  approvedBy String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  hunt       Hunt           @relation(fields: [huntId], references: [id], onDelete: Cascade)

  @@index([huntId])
}
