{
  "name": "haunted-ops",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint && pnpm lint:tools",
    "lint:tools": "eslint tools scripts",
    "test": "pnpm -r --if-present test && pnpm test:scripts",
    "test:scripts": "node --test scripts/g1-score.test.mjs scripts/g2-hunt.test.mjs scripts/check-scene-bundle.test.mjs tools/sanitize-replay/sanitize-hunt-stream.test.mjs tools/fake-kiro-cli/fake-kiro-cli.test.mjs",
    "build": "pnpm -r --if-present build",
    "check:build": "node tools/check-build-determinism/check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
