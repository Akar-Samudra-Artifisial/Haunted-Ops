# Names and placeholder values only. Never commit real values.

# --- apps/api/.env (git-ignored) ---
# Required
DATABASE_URL=postgresql://USER@localhost:5432/haunted_dev
PORT=3000
WEB_ORIGIN=http://localhost:5173
# Optional (defaults shown)
HOST=127.0.0.1
SSE_MAX_CLIENTS=100
SSE_MAX_CLIENTS_PER_IP=5
RATE_LIMIT_MAX=30
# Reverse proxies in front of the API whose X-Forwarded-For is trusted (0 to 3). 0 trusts none.
TRUST_PROXY_HOPS=0
# Prometheus polling (defaults shown). PROMETHEUS_URL is an origin: scheme, host, optional port, no path.
PROMETHEUS_URL=http://127.0.0.1:9090
# PROMETHEUS_URL must name a loopback host (127.0.0.1, [::1], localhost) unless this is true.
# Link-local hosts (169.254.0.0/16, fe80::/10) are always refused.
PROMETHEUS_ALLOW_REMOTE=false
# Poll interval 1000 to 60000 ms; request timeout 100 to 30000 ms and not above the interval.
POLL_INTERVAL_MS=5000
POLL_TIMEOUT_MS=3000
# Signals older than this many hours are deleted (1 to 720).
SIGNAL_RETENTION_H=24
# G1 and G2 checks only (scripts/g1-score.mjs, scripts/g2-hunt.mjs). The lab supervisor chaos API and its
# bearer token, from haunted-lab. The G2 script also reads SCENARIO_SHAS (default ../haunted-lab/scripts/scenario-shas.json).
API_URL=http://127.0.0.1:3000
CHAOS_URL=http://127.0.0.1:4100
CHAOS_TOKEN=change-me-use-the-lab-chaos-token
# --- The Exorcist (hunts). A Hunt spends Kiro Credits: everything below is off until HUNTS_ENABLED=true. ---
# Hunts start only when this is true. It also needs LAB_READ_TOKEN, HUNT_ADMIN_TOKEN and a runnable KIRO_CLI_PATH.
HUNTS_ENABLED=false
# The lab observability API (`/lab/*`) and its read-only bearer token (24+ characters, not a change-me value).
# LAB_URL must name a loopback host unless LAB_ALLOW_REMOTE is true; link-local hosts are always refused.
LAB_URL=http://127.0.0.1:4100
LAB_ALLOW_REMOTE=false
LAB_READ_TOKEN=change-me-use-the-lab-read-token
# Bearer token of the operator route `POST /api/hunts` (24+ characters, different from LAB_READ_TOKEN).
HUNT_ADMIN_TOKEN=change-me-use-a-hunt-admin-token
# The kiro-cli binary (a name on PATH or an absolute path); tests use tools/fake-kiro-cli through a wrapper.
KIRO_CLI_PATH=kiro-cli
# A pinned model name, never `auto`.
EXORCIST_MODEL=claude-sonnet-5.5
# Credits: at most this many per Hunt (0.1 to 10) and per UTC day (not below the per-hunt cap, 500 at most).
HUNT_CREDIT_CAP=1.5
HUNT_DAILY_CREDIT_CAP=30
# Wall-clock limit of a Hunt (10000 to 300000), pause after a Hunt of the same Service (0 to 3600000),
# and the most tool calls of a Hunt (3 to 30).
HUNT_TIMEOUT_MS=90000
HUNT_COOLDOWN_MS=120000
# Wait after an Incident opens before an automatic Hunt picks the most downstream Incident (0 to 60000)
HUNT_SETTLE_MS=10000
HUNT_MAX_TOOL_CALLS=20
# Hunts that may start per UTC day, automatic and operator together (1 to 500). Beyond it a request is recorded as cancelled.
HUNT_DAILY_MAX=40
# Working directory of a Hunt: absolute, outside every git repository (default in development: <os temp dir>/haunted-ops-hunts).
# With NODE_ENV=production and hunts on it is required, owned by the server user, mode 0700.
# HUNT_WORKDIR=
# --- The fix flow (a fixer agent, a pull request on the lab repo, a deploy once a human merges it). Off by default. ---
# Needs HUNTS_ENABLED=true, GITHUB_TOKEN, LAB_GITHUB_REPO, CHAOS_TOKEN and WEB_ORIGIN.
FIX_ENABLED=false
# A fine-grained token for the lab repo only: Contents and Pull requests read and write. Classic tokens are refused.
# GITHUB_TOKEN=github_pat_change-me
# LAB_GITHUB_REPO=owner/name
# Chaos API of the lab (loopback unless LAB_ALLOW_REMOTE) and its bearer token (24+ characters, different from the other tokens).
# CHAOS_URL=http://127.0.0.1:4100
# CHAOS_TOKEN=change-me-use-the-lab-chaos-token
# The fixer: pinned model, credits per run (0.1 to 10), wall clock (10000 to 300000), tool calls (3 to 60).
# FIX_MODEL=claude-sonnet-5.5
# FIX_CREDIT_CAP=1.5
# FIX_TIMEOUT_MS=120000
# FIX_MAX_TOOL_CALLS=30
# The test run on a candidate (10000 to 300000), and whether a service with no test file fails the check.
# FIX_TEST_TIMEOUT_MS=90000
# FIX_REQUIRE_TESTS=true
# Pull request polling (5000 to 300000) and the age of branches before the cleanup deletes them (1 to 60 days).
# FIX_POLL_MS=30000
# FIX_BRANCH_TTL_DAYS=7
# How long after the merge the lab may take to list the Deploy Record of the fix (10000 to 3600000). Until then the
# Proposal stays merged and is looked at again on every poll; after it, it ends failed / deploy_unconfirmed.
# FIX_DEPLOY_CONFIRM_MS=300000
# FIX_ENABLED=true needs Node 25 or later: the test run of a candidate relies on the network gate of --permission.
# Folder of the fix flow: the API's clone, the fixer folders, pid notes. Absolute, outside every git repository;
# required in production (owned by the server user, mode 0700). Default: <os temp dir>/haunted-ops-fix.
# FIX_WORKDIR=
# Integration tests only. Must differ from DATABASE_URL.
TEST_DATABASE_URL=postgresql://USER@localhost:5432/haunted_test

# --- apps/web/.env (git-ignored) ---
VITE_API_BASE_URL=http://localhost:3000
# Demo mode (`?demo=1`, `?demo=<scenario>`) always works in development; set true to allow it in a production build.
VITE_DEMO_MODE=false
