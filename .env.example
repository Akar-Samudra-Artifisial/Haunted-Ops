# Names and placeholder values only. Never commit real values.

# --- apps/api/.env (git-ignored) ---
# Required
DATABASE_URL=postgresql://USER@localhost:5432/haunted_dev
PORT=3000
WEB_ORIGIN=http://localhost:5173
# Optional (defaults shown)
HOST=127.0.0.1
SSE_MAX_CLIENTS=100
SSE_MAX_CLIENTS_PER_IP=5
RATE_LIMIT_MAX=30
# Reverse proxies in front of the API whose X-Forwarded-For is trusted (0 to 3). 0 trusts none.
TRUST_PROXY_HOPS=0
# Integration tests only. Must differ from DATABASE_URL.
TEST_DATABASE_URL=postgresql://USER@localhost:5432/haunted_test

# --- apps/web/.env (git-ignored) ---
VITE_API_BASE_URL=http://localhost:3000
