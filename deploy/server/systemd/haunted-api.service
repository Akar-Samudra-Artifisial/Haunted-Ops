# Haunted Ops API on the demo server. Runs as hops; the hunt child (kiro-cli) lives in the same cgroup.
[Unit]
Description=Haunted Ops API (demo server)
After=network.target postgresql.service haunted-lab.service
Wants=postgresql.service
ConditionPathExists=/etc/haunted/api.env
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=hops
Group=hops
Environment=NODE_ENV=production
Environment=HOME=/var/lib/hops
EnvironmentFile=/etc/haunted/api.env
# Optional (the "-"): the Kiro API key, root:root 0600, read by systemd as root. Only this unit loads it.
EnvironmentFile=-/etc/haunted/kiro.env
WorkingDirectory=/opt/haunted-ops/current/apps/api
# The env guard refuses an unsafe file before the API starts (it prints names, never values).
ExecStartPre=/usr/local/bin/node /opt/haunted-ops/current/scripts/demo-env-check.mjs /etc/haunted/api.env api
# The same guard for the key file (a missing file is accepted). hops cannot read that file, so this one line runs as root ("+").
ExecStartPre=+/usr/local/bin/node /opt/haunted-ops/current/scripts/demo-env-check.mjs /etc/haunted/kiro.env kiro
ExecStart=/usr/local/bin/node /opt/haunted-ops/current/apps/api/dist/main.js
Restart=on-failure
RestartSec=5
# Memory ceiling for the API and the hunt child together; the swapfile absorbs short peaks.
MemoryMax=1G
MemorySwapMax=512M
TasksMax=256
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# The home of hops holds the hunt working folder and the kiro-cli state folder. Nothing else is writable.
ReadWritePaths=/var/lib/hops
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
