# Versions pinned by install.sh. Every file the script downloads is checked against a sha256 from this file (or, for the release, RELEASE_SHA256) before it is used.
# Node: the checksum is the line of SHASUMS256.txt published by nodejs.org for this file.
NODE_VERSION=26.13.1
NODE_TARBALL=node-v26.13.1-linux-x64.tar.xz
NODE_SHA256=5c063e46bab0fbc1c17cc445d7ff129cbdcd0471be6ed83b6ab864f8143bc864
# pnpm: the tarball of the npm registry (a bundle that runs on Node alone). The version must equal "packageManager" of package.json.
# The checksum is the sha256 of https://registry.npmjs.org/pnpm/-/pnpm-<version>.tgz. A test keeps the two versions equal.
PNPM_VERSION=11.7.0
PNPM_SHA256=deafa7ec98a1218b6a047289b92fbe2395c1e22d3495bb711653013218ee15ee
# Caddy: the oldest version the Caddyfile is written for (Debian 13 ships 2.6.2). preflight.sh fails on an older one. The Caddyfile uses only syntax of this version: the "defer" subdirective of "header", no ">" prefix.
CADDY_MIN_VERSION=2.6.2
