# Haunted Ops API on the demo server. Names and safe defaults only.
# install.sh copies this file to /etc/haunted/api.env (mode 0640, group hops) when that file does not exist,
# then replaces each __NAME__ and CHANGE_ME_ placeholder. Never put a real value in this example.
# scripts/demo-env-check.mjs refuses the file at every start of the API if a rule below is broken.
NODE_ENV=production
PORT=3000
# Loopback only: Caddy is the only way in.
HOST=127.0.0.1
WEB_ORIGIN=https://__HAUNTED_DOMAIN__
# One reverse proxy (Caddy) in front of the API.
TRUST_PROXY_HOPS=1
DATABASE_URL=postgresql://hops:__DB_PASSWORD__@127.0.0.1:5432/haunted
# The fixer never runs on the demo server and no GitHub token exists here.
FIX_ENABLED=false
# false is the third layer of the kill switch (the others: the API endpoint, the scenario timer).
HUNTS_ENABLED=true
LAB_URL=http://127.0.0.1:4100
PROMETHEUS_URL=http://127.0.0.1:9090
# Generated by install.sh with openssl rand; the lab has the same LAB_READ_TOKEN. The two tokens differ.
LAB_READ_TOKEN=CHANGE_ME_LAB_READ_TOKEN
HUNT_ADMIN_TOKEN=CHANGE_ME_HUNT_ADMIN_TOKEN
KIRO_CLI_PATH=/usr/local/bin/kiro-cli
EXORCIST_MODEL=claude-sonnet-5.5
HUNT_WORKDIR=/var/lib/hops/hunts
# At most 3 hunts per UTC day, 1.5 credits each, 4.5 credits a day.
HUNT_DAILY_MAX=3
HUNT_CREDIT_CAP=1.5
HUNT_DAILY_CREDIT_CAP=4.5
