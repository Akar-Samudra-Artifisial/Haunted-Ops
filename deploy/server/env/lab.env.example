# Haunted Lab on the demo server. Names and safe defaults only.
# install.sh copies this file to /etc/haunted/lab.env (mode 0640, group hlab) when that file does not exist,
# then replaces each CHANGE_ME_ placeholder. Never put a real value in this example.
NODE_ENV=production
CHAOS_TOKEN=CHANGE_ME_CHAOS_TOKEN
# The same value as LAB_READ_TOKEN of the API (install.sh writes one value to both files).
LAB_READ_TOKEN=CHANGE_ME_LAB_READ_TOKEN
SUPERVISOR_PORT=4100
GATE_PORT=4001
ORDERS_PORT=4002
PAYMENTS_PORT=4003
LEDGER_PORT=4004
# Loopback only. The lab has no fix deploy here: FIX_RUN_AS_USER stays unset, so its deploy-fix answers 503.
SERVICE_BIND_HOST=127.0.0.1
TRAFFIC_RPS=5
LAB_REPO_DIR=/opt/haunted-lab
LAB_DATA_DIR=/var/lib/haunted-lab/data
LAB_WORKTREES_DIR=/var/lib/haunted-lab/worktrees
LAB_ECHO_CHILD_OUTPUT=0
